{
  "name": "elternzeugnis",
  "version": "0.1.0",
  "private": true,
  "description": "Eine tabletfreundliche Zeugnis-App, mit der Kinder wertschätzende Elternzeugnisse erstellen können.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-version.mjs",
    "dev": "vite --host 127.0.0.1",
